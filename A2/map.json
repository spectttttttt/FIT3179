{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 600,
  "projection": {"type": "mercator", "center": [0, 20], "scale": 150},
  "params": [
    {
      "name": "CuisineSelect",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "American",
          "Asian",
          "Bar",
          "Cafe",
          "Chinese",
          "French",
          "Indian",
          "Italian",
          "Japanese",
          "Mediterranean",
          "Pizza",
          "Pub",
          "Seafood",
          "Sushi",
          "Thai",
          "Vegetarian Friendly",
          "Vegan Options"
        ],
        "name": "Filter by Cuisine: "
      }
    }
  ],
  "layer": [
    {
      "mark": {"type": "rect"},
      "data": {"values": [{}]},
      "encoding": {"color": {"value": "#b3d9ff"}}
    },
    {
      "data": {"graticule": {"step": [10, 10]}},
      "mark": {"type": "geoshape", "stroke": "#e7e7e7", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#f0f0f0", "stroke": "#999"}
    },
    {
      "data": {
        "url": "https://spectttttttt.github.io/FIT3179/A2/restaurant_data.json"
      },
      "transform": [
        {"filter": "datum.LATITUDE != null && datum.LONGITUDE != null"},
        {"calculate": "toNumber(datum.RATING)", "as": "RATING_NUM"},
        {"calculate": "toNumber(datum.NUMBER_OF_REVIEWS)", "as": "REVIEWS_NUM"},
        {"flatten": ["CUISINES"]},
        {
          "filter": "CuisineSelect == 'All' || lower(datum.CUISINES) == lower(CuisineSelect)"
        },
        {
          "aggregate": [
            {"op": "mean", "field": "RATING_NUM", "as": "AVG_RATING"},
            {"op": "sum", "field": "REVIEWS_NUM", "as": "TOTAL_REVIEWS"},
            {"op": "mean", "field": "LATITUDE", "as": "AVG_LAT"},
            {"op": "mean", "field": "LONGITUDE", "as": "AVG_LON"}
          ],
          "groupby": ["DESTINATION"]
        },
        {"bin": {"maxbins": 4}, "field": "TOTAL_REVIEWS", "as": "REVIEWS_BIN"}
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#333",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {"field": "AVG_LON", "type": "quantitative"},
        "latitude": {"field": "AVG_LAT", "type": "quantitative"},
        "size": {
          "field": "REVIEWS_BIN",
          "type": "ordinal",
          "scale": {"range": [250, 2000]},
          "title": "Total Reviews"
        },
        "color": {
          "field": "AVG_RATING",
          "type": "quantitative",
          "title": "Average Rating",
          "scale": {"scheme": "greens"}
        },
        "tooltip": [
          {"field": "DESTINATION", "title": "City / Country"},
          {"field": "AVG_RATING", "title": "Average Rating", "format": ".2f"},
          {"field": "TOTAL_REVIEWS", "title": "Total Reviews", "format": ","}
        ]
      }
    },
    {
      "data": {
        "url": "https://spectttttttt.github.io/FIT3179/A2/restaurant_data.json"
      },
      "transform": [
        {"filter": "datum.LATITUDE != null && datum.LONGITUDE != null"},
        {"calculate": "toNumber(datum.RATING)", "as": "RATING_NUM"},
        {"calculate": "toNumber(datum.NUMBER_OF_REVIEWS)", "as": "REVIEWS_NUM"},
        {"flatten": ["CUISINES"]},
        {
          "filter": "CuisineSelect == 'All' || lower(datum.CUISINES) == lower(CuisineSelect)"
        },
        {
          "aggregate": [
            {"op": "mean", "field": "RATING_NUM", "as": "AVG_RATING"},
            {"op": "sum", "field": "REVIEWS_NUM", "as": "TOTAL_REVIEWS"},
            {"op": "mean", "field": "LATITUDE", "as": "AVG_LAT"},
            {"op": "mean", "field": "LONGITUDE", "as": "AVG_LON"}
          ],
          "groupby": ["DESTINATION"]
        },
        {
          "window": [{"op": "rank", "as": "rank"}],
          "sort": [
            {"field": "AVG_RATING", "order": "descending"},
            {"field": "TOTAL_REVIEWS", "order": "descending"}
          ]
        },
        {"filter": "datum.rank == 1"},
        {"calculate": "datum.TOTAL_REVIEWS", "as": "REVIEWS_BIN"},
        {
          "calculate": "'→ Highest Rating: ' + datum.DESTINATION",
          "as": "annotation"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#ffd334fc",
            "stroke": "#666100",
            "strokeWidth": 1,
            "opacity": 0.65
          },
          "encoding": {
            "longitude": {"field": "AVG_LON", "type": "quantitative"},
            "latitude": {"field": "AVG_LAT", "type": "quantitative"},
            "size": {
              "field": "REVIEWS_BIN",
              "type": "ordinal",
              "scale": {"range": [250, 2000]},
              "title": "Total Reviews"
            },
            "tooltip": [
              {"field": "DESTINATION", "title": "Top Location"},
              {"field": "AVG_RATING", "title": "Avg Rating", "format": ".2f"},
              {
                "field": "TOTAL_REVIEWS",
                "title": "Total Reviews",
                "format": ","
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 20,
            "dy": -8,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#000000"
          },
          "encoding": {
            "longitude": {"field": "AVG_LON", "type": "quantitative"},
            "latitude": {"field": "AVG_LAT", "type": "quantitative"},
            "text": {"field": "annotation"}
          }
        }
      ]
    }
  ],
  "title": {
    "text": "Global Restaurant Ratings by Cuisine Type",
    "fontSize": 14,
    "anchor": "middle"
  },
  "config": {}
}