{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1000,
  "height": 600,
  "projection": {"type": "mercator", "center": [110, 3], "scale": 2750},
  "layer": [
    {
      "mark": {"type": "rect"},
      "data": {"values": [{}]},
      "encoding": {"color": {"value": "#cce5ff"}}
    },
    {
      "data": {"graticule": {"step": [5, 5]}},
      "mark": {"type": "geoshape", "stroke": "#8e8e8e", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.id == 458"}],
      "mark": {"type": "geoshape", "fill": "#f0f0f0", "stroke": "#666666"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/spectttttttt/FIT3179/main/Homework/W9/daerah-working-set.csv"
      },
      "transform": [
        {
          "aggregate": [
            {"op": "count", "as": "TownCount"},
            {"op": "mean", "field": "Lat", "as": "Lat"},
            {"op": "mean", "field": "Lon", "as": "Lon"}
          ],
          "groupby": ["States"]
        }
      ],
      "mark": {"type": "circle", "tooltip": true},
      "encoding": {
        "longitude": {"field": "Lon", "type": "quantitative"},
        "latitude": {"field": "Lat", "type": "quantitative"},
        "size": {
          "field": "TownCount",
          "type": "quantitative",
          "title": "Number of Towns",
          "scale": {"domainMin": 1, "range": [200, 2500]}
        },
        "color": {
          "field": "States",
          "type": "nominal",
          "title": "State",
          "scale": {"scheme": "tableau20"},
          "legend": {"orient": "right"}
        },
        "tooltip": [
          {"field": "States", "title": "State"},
          {"field": "TownCount", "title": "Number of Towns"}
        ]
      }
    }
  ],
  "title": {
    "text": "Distribution of Towns Across Malaysian States",
    "fontSize": 18,
    "anchor": "middle"
  },
  "config": {}
}